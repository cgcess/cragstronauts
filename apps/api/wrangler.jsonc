{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cragstronauts",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }
  ],
  // Every secret the worker needs at runtime. A deploy fails when one is
  // unset on the remote worker, and `wrangler dev` warns. Keep this list
  // complete: wrangler binds only the secrets named here, so an unlisted one
  // silently never reaches the worker.
  "secrets": {
    "required": [
      "CLERK_PUBLISHABLE_KEY",
      "CLERK_SECRET_KEY",
      "CLERK_WEBHOOK_SIGNING_SECRET",
      "DISCORD_WEBHOOK_URL",
      "VAPID_PRIVATE_KEY",
      "VAPID_PUBLIC_KEY",
      "VAPID_SUBJECT"
    ]
  },
  "observability": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TRIP_DO",
        "class_name": "TripDO"
      },
      {
        "name": "TRIP_INDEX",
        "class_name": "TripIndexDO"
      },
      {
        "name": "ACCOUNT_DO",
        "class_name": "AccountDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TripDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["TripIndexDO"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["AccountIndexDO"]
    },
    {
      "tag": "v4",
      "renamed_classes": [{ "from": "AccountIndexDO", "to": "AccountDO" }]
    }
  ]
}
