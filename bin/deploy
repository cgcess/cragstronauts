#!/usr/bin/env bash
set -euo pipefail

# Deploy Cragstronauts: push production Worker secrets, then build + deploy.
#
# `pnpm run deploy` wraps turbo in `zero vault run`, so the web build gets its
# production build-time values without any file being written. See
# docs/secrets.md.

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

"$ROOT/bin/sync-secrets-to-cloudflare"
pnpm run deploy
